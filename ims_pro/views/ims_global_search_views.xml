<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_ims_global_search_form" model="ir.ui.view">
        <field name="name">ims.global.search.form</field>
        <field name="model">ims.global.search</field>
        <field name="arch" type="xml">
            <form string="IMS Global Search">
                <header>
                    <button name="action_search" type="object" string="Search IMS" class="btn-primary"/>
                </header>
                <sheet>
                    <group>
                        <field name="query" placeholder="Document code, title, process, action, standard, clause..."/>
                    </group>
                    <field name="result_ids" nolabel="1">
                        <list create="0" delete="0">
                            <field name="record_type"/>
                            <field name="result_name"/>
                            <button name="action_open_record" type="object" string="Open"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_ims_global_search" model="ir.actions.act_window">
        <field name="name">IMS Global Search</field>
        <field name="res_model">ims.global.search</field>
        <field name="view_mode">form</field>
        <field name="target">current</field>
    </record>
    <menuitem id="menu_ims_global_search" name="Search IMS" parent="menu_ims_root"
              action="action_ims_global_search" sequence="5"/>
</odoo>
