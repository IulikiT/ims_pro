<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_ims_risk_project_list" model="ir.ui.view">
        <field name="name">ims.risk.project.list</field><field name="model">ims.risk.project</field>
        <field name="arch" type="xml"><list><field name="code"/><field name="name"/><field name="domain"/><field name="process_id"/><field name="owner_id"/><field name="matrix_id"/><field name="next_review_date"/><field name="state"/></list></field>
    </record>
    <record id="view_ims_risk_project_form" model="ir.ui.view">
        <field name="name">ims.risk.project.form</field><field name="model">ims.risk.project</field>
        <field name="arch" type="xml">
            <form string="Risk Management Project"><header><field name="state" widget="statusbar"/></header><sheet>
                <div class="oe_title"><label for="name"/><h1><field name="name"/></h1></div>
                <group><group string="Project"><field name="code"/><field name="domain"/><field name="process_id"/><field name="department_id"/></group>
                <group string="Assessment &amp; Review"><field name="owner_id"/><field name="matrix_id"/><field name="review_frequency_months"/><field name="next_review_date"/></group></group>
                <notebook>
                    <page string="Project Scope / Description"><field name="description"/></page>
                    <page string="Hazards / Aspects / Sources">
                        <field name="hazard_ids"><list editable="bottom"><field name="sequence"/><field name="name"/><field name="category"/><field name="source"/><field name="activity"/><field name="location"/><field name="condition"/><field name="directness"/></list></field>
                    </page>
                    <page string="Standards &amp; Clauses"><field name="standard_clause_ids" widget="many2many_tags"/></page>
                </notebook>
            </sheet><chatter/></form>
        </field>
    </record>
    <record id="action_ims_risk_project" model="ir.actions.act_window"><field name="name">Risk Projects</field><field name="res_model">ims.risk.project</field><field name="view_mode">list,form</field></record>

    <record id="view_ims_risk_case_search" model="ir.ui.view">
        <field name="name">ims.risk.case.search</field><field name="model">ims.risk.case</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/><field name="title"/><field name="project_id"/><field name="responsible_id"/>
                <filter string="Open" name="open" domain="[('state','!=','closed')]"/>
                <filter string="High / Critical Residual" name="high" domain="[('residual_level','in',('HIGH','CRITICAL'))]"/>
                <filter string="OH&amp;S" name="ohs" domain="[('project_id.domain','=','ohs')]"/>
                <filter string="Environment" name="env" domain="[('project_id.domain','=','environment')]"/>
                <separator/>
                <filter string="Project" name="g_project" context="{'group_by':'project_id'}"/>
                <filter string="Residual Level" name="g_res" context="{'group_by':'residual_level'}"/>
                <filter string="Responsible" name="g_owner" context="{'group_by':'responsible_id'}"/>
                <filter string="Status" name="g_state" context="{'group_by':'state'}"/>
            </search>
        </field>
    </record>
    <record id="view_ims_risk_case_list" model="ir.ui.view">
        <field name="name">ims.risk.case.list</field><field name="model">ims.risk.case</field>
        <field name="arch" type="xml">
            <list decoration-danger="residual_level == 'CRITICAL'" decoration-warning="residual_level == 'HIGH'">
                <field name="name"/><field name="title"/><field name="project_id"/>
                <field name="initial_score"/><field name="initial_level"/>
                <field name="residual_score"/><field name="residual_level"/>
                <field name="responsible_id"/><field name="due_date"/><field name="review_date"/><field name="state"/>
            </list>
        </field>
    </record>
    <record id="view_ims_risk_case_form" model="ir.ui.view">
        <field name="name">ims.risk.case.form</field><field name="model">ims.risk.case</field>
        <field name="arch" type="xml">
            <form string="Risk / Opportunity Case"><header><field name="state" widget="statusbar"/></header><sheet>
                <div class="oe_title"><label for="title"/><h1><field name="title"/></h1></div>
                <group><group string="Identification"><field name="name"/><field name="hazard_id"/><field name="project_id"/><field name="opportunity"/></group>
                <group string="Responsibility"><field name="responsible_id"/><field name="due_date"/><field name="review_date"/></group></group>
                <notebook>
                    <page string="1. Event / Consequence"><field name="event"/><field name="consequence"/></page>
                    <page string="2. Initial Risk">
                        <group><group><field name="initial_probability_id"/><field name="initial_severity_id"/></group>
                        <group><field name="initial_score"/><field name="initial_level"/></group></group>
                    </page>
                    <page string="3. Existing &amp; Additional Controls">
                        <field name="control_ids" widget="many2many_tags"/>
                        <field name="action_ids"/>
                    </page>
                    <page string="4. Residual Risk">
                        <group><group><field name="residual_probability_id"/><field name="residual_severity_id"/></group>
                        <group><field name="residual_score"/><field name="residual_level"/></group></group>
                        <field name="acceptance_justification"/>
                        <field name="contingency_response"/>
                    </page>
                    <page string="5. Periodic Reviews">
                        <field name="review_ids"><list editable="bottom"><field name="reviewed_by_id"/><field name="review_date"/><field name="next_review_date"/></list></field>
                    </page>
                </notebook>
            </sheet><chatter/></form>
        </field>
    </record>
    <record id="action_ims_risk_case" model="ir.actions.act_window"><field name="name">Risk Cases / Environmental Aspects</field><field name="res_model">ims.risk.case</field><field name="view_mode">kanban,list,form</field><field name="search_view_id" ref="view_ims_risk_case_search"/></record>

    <record id="action_ims_risk_control" model="ir.actions.act_window"><field name="name">Risk Controls</field><field name="res_model">ims.risk.control</field><field name="view_mode">list,form</field></record>
    <record id="action_ims_risk_matrix" model="ir.actions.act_window"><field name="name">Risk Matrices</field><field name="res_model">ims.risk.matrix</field><field name="view_mode">list,form</field></record>
    <menuitem id="menu_ims_risk_project" name="Risk Projects" parent="menu_ims_risk_root" action="action_ims_risk_project" sequence="10"/>
    <menuitem id="menu_ims_risk_case" name="Risk Cases / Aspects" parent="menu_ims_risk_root" action="action_ims_risk_case" sequence="20"/>
    <menuitem id="menu_ims_risk_control" name="Risk Controls &amp; Actions" parent="menu_ims_risk_root" action="action_ims_risk_control" sequence="30"/>
    <menuitem id="menu_ims_risk_matrix" name="Risk Matrix Templates" parent="menu_ims_configuration" action="action_ims_risk_matrix" sequence="50"/>
</odoo>
