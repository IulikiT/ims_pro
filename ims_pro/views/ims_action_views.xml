<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_ims_action_search" model="ir.ui.view">
        <field name="name">ims.action.search</field>
        <field name="model">ims.action</field>
        <field name="arch" type="xml">
            <search>
                <field name="reference"/>
                <field name="name"/>
                <field name="process_id"/>
                <field name="responsible_id"/>
                <filter name="my_actions" string="My Actions" domain="[('responsible_id','=',uid)]"/>
                <filter name="open_actions" string="Open" domain="[('state','not in',('done','cancelled'))]"/>
                <filter name="overdue" string="Overdue" domain="[('is_overdue','=',True)]"/>
                <separator/>
                <filter name="group_source" string="Source" context="{'group_by':'source_type'}"/>
                <filter name="group_process" string="Process" context="{'group_by':'process_id'}"/>
                <filter name="group_responsible" string="Responsible" context="{'group_by':'responsible_id'}"/>
                <filter name="group_state" string="Status" context="{'group_by':'state'}"/>
            </search>
        </field>
    </record>
    <record id="view_ims_action_list" model="ir.ui.view">
        <field name="name">ims.action.list</field>
        <field name="model">ims.action</field>
        <field name="arch" type="xml">
            <list decoration-danger="is_overdue">
                <field name="reference"/><field name="name"/><field name="source_type"/>
                <field name="process_id"/><field name="responsible_id"/><field name="due_date"/>
                <field name="priority"/><field name="state"/><field name="is_overdue"/>
            </list>
        </field>
    </record>
    <record id="view_ims_action_form" model="ir.ui.view">
        <field name="name">ims.action.form</field>
        <field name="model">ims.action</field>
        <field name="arch" type="xml">
            <form string="IMS Action">
                <header>
                    <button name="action_start" type="object" string="Start" invisible="state != 'open'"/>
                    <button name="action_close" type="object" string="Close" invisible="state in ('done','cancelled')" class="btn-primary"/>
                    <button name="action_reopen" type="object" string="Reopen" invisible="state != 'done'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group><field name="reference"/><field name="name"/><field name="source_type"/><field name="process_id"/></group>
                        <group><field name="responsible_id"/><field name="due_date"/><field name="priority"/><field name="is_overdue"/></group>
                    </group>
                    <notebook><page string="Description"><field name="description"/></page><page string="Evidence"><field name="evidence"/></page></notebook>
                </sheet><chatter/>
            </form>
        </field>
    </record>
    <record id="action_ims_action" model="ir.actions.act_window">
        <field name="name">IMS Actions</field>
        <field name="res_model">ims.action</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_ims_action_search"/>
        <field name="domain">[('responsible_id','=',uid)]</field>
    </record>
    <menuitem id="menu_ims_actions" name="My IMS Actions" parent="menu_ims_my" action="action_ims_action" sequence="10"/>
</odoo>
