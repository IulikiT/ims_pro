<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_report_ims_controlled_document" model="ir.actions.report">
        <field name="name">IMS Controlled Document</field>
        <field name="model">ims.document.revision</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">ims_pro.report_ims_controlled_document</field>
        <field name="report_file">ims_pro.report_ims_controlled_document</field>
        <field name="print_report_name">'%s_Rev_%s' % (object.document_id.code, object.revision)</field>
    </record>

    <template id="report_ims_controlled_document">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
                    <div class="page">
                        <div t-if="o.template_id and o.template_id.header_html"
                             t-field="o.template_id.header_html"/>
                        <div class="row mb-3">
                            <div class="col-8">
                                <h2><span t-field="o.document_id.name"/></h2>
                                <strong>Document ID:</strong> <span t-field="o.document_id.code"/>
                            </div>
                            <div class="col-4">
                                <div><strong>Revision:</strong> <span t-field="o.revision"/></div>
                                <div><strong>Status:</strong> <span t-field="o.state"/></div>
                                <div><strong>Effective Date:</strong> <span t-field="o.effective_date"/></div>
                            </div>
                        </div>
                        <hr/>
                        <div t-field="o.body_html"/>
                        <hr/>
                        <div t-if="o.template_id and o.template_id.footer_html"
                             t-field="o.template_id.footer_html"/>
                        <div class="text-muted mt-3">
                            Controlled copy generated by IMS Pro.
                        </div>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
