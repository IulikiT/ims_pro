<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="ims_pro.IMSProDashboard">
        <div class="o_action ims_pro_dashboard bg-view">
            <div class="o_control_panel border-bottom bg-white">
                <div class="o_control_panel_main d-flex flex-wrap align-items-center justify-content-between gap-2 px-3 py-2">
                    <div>
                        <h2 class="mb-0 fs-4">IMS Pro</h2>
                        <div class="text-muted small">Integrated Management System</div>
                    </div>
                    <div class="d-flex gap-2">
                        <button type="button" class="btn btn-secondary" t-on-click="openSearch">
                            <i class="fa fa-search me-1" title="Search"/> Search IMS
                        </button>
                        <button type="button" class="btn btn-primary" t-on-click="openMyActions">
                            <i class="fa fa-check-square-o me-1" title="My Actions"/> My IMS Actions
                        </button>
                    </div>
                </div>
            </div>

            <div t-if="state.loading" class="p-5 text-center text-muted">
                <i class="fa fa-spinner fa-spin fa-2x" title="Loading"/>
            </div>

            <t t-else="">
                <div class="container-fluid py-3 ims_content">
                    <div class="row g-3 mb-3">
                        <div class="col-6 col-md-4 col-xl-2">
                            <button type="button" class="card w-100 h-100 text-start ims_stat_card" t-on-click="() => openAction('ims_pro.action_ims_document_library')">
                                <div class="card-body d-flex align-items-center gap-3"><i class="fa fa-book fa-lg text-primary" title="Documents"/><div><div class="text-muted small">Active Documents</div><div class="fs-3 fw-semibold" t-esc="state.data.kpis.active_documents || 0"/></div></div>
                            </button>
                        </div>
                        <div class="col-6 col-md-4 col-xl-2">
                            <div class="card h-100 ims_stat_card"><div class="card-body d-flex align-items-center gap-3"><i class="fa fa-clock-o fa-lg text-warning" title="Approvals"/><div><div class="text-muted small">My Approvals</div><div class="fs-3 fw-semibold" t-esc="state.data.kpis.pending_approvals || 0"/></div></div></div>
                        </div>
                        <div class="col-6 col-md-4 col-xl-2">
                            <button type="button" class="card w-100 h-100 text-start ims_stat_card" t-on-click="openMyActions"><div class="card-body d-flex align-items-center gap-3"><i class="fa fa-calendar-times-o fa-lg text-danger" title="Overdue"/><div><div class="text-muted small">Overdue Actions</div><div class="fs-3 fw-semibold" t-esc="state.data.kpis.overdue_actions || 0"/></div></div></button>
                        </div>
                        <div class="col-6 col-md-4 col-xl-2">
                            <button type="button" class="card w-100 h-100 text-start ims_stat_card" t-on-click="() => openAction('ims_pro.action_ims_risk_case')"><div class="card-body d-flex align-items-center gap-3"><i class="fa fa-exclamation-triangle fa-lg text-danger" title="Risks"/><div><div class="text-muted small">High / Critical Risks</div><div class="fs-3 fw-semibold" t-esc="state.data.kpis.high_risks || 0"/></div></div></button>
                        </div>
                        <div class="col-6 col-md-4 col-xl-2">
                            <button type="button" class="card w-100 h-100 text-start ims_stat_card" t-on-click="() => openAction('ims_pro.action_ims_capa')"><div class="card-body d-flex align-items-center gap-3"><i class="fa fa-refresh fa-lg text-info" title="CAPA"/><div><div class="text-muted small">Open CAPA</div><div class="fs-3 fw-semibold" t-esc="state.data.kpis.open_capa || 0"/></div></div></button>
                        </div>
                        <div class="col-6 col-md-4 col-xl-2">
                            <button type="button" class="card w-100 h-100 text-start ims_stat_card" t-on-click="() => openAction('ims_pro.action_ims_audit_finding')"><div class="card-body d-flex align-items-center gap-3"><i class="fa fa-search fa-lg text-primary" title="Audit findings"/><div><div class="text-muted small">Open Audit Findings</div><div class="fs-3 fw-semibold" t-esc="state.data.kpis.open_findings || 0"/></div></div></button>
                        </div>
                    </div>

                    <div class="card mb-3">
                        <div class="card-header bg-white"><strong>IMS Workspace</strong><div class="text-muted small">Open a module using the same navigation patterns as standard Odoo applications.</div></div>
                        <div class="card-body">
                            <div class="row g-2">
                                <t t-foreach="modules" t-as="mod" t-key="mod.key">
                                    <div class="col-12 col-md-6 col-xl-4 col-xxl-3">
                                        <button type="button" class="btn btn-light border w-100 text-start p-3 ims_module_native" t-on-click="() => openAction(mod.action)">
                                            <div class="d-flex align-items-start gap-3"><i t-attf-class="fa #{mod.icon} fa-lg text-primary mt-1" t-att-title="mod.title"/><div class="flex-grow-1"><div class="text-muted text-uppercase ims_group_label" t-esc="mod.group"/><div class="fw-semibold" t-esc="mod.title"/><div class="small text-muted" t-esc="mod.subtitle"/></div><i class="fa fa-angle-right text-muted mt-1" title="Open"/></div>
                                        </button>
                                    </div>
                                </t>
                            </div>
                        </div>
                    </div>

                    <div class="row g-3">
                        <div class="col-12 col-xl-6">
                            <div class="card h-100">
                                <div class="card-header bg-white d-flex justify-content-between align-items-center"><div><strong>Residual Risk Heatmap</strong><div class="text-muted small">Open risks after implemented controls</div></div><button type="button" class="btn btn-sm btn-secondary" t-on-click="() => openAction('ims_pro.action_ims_risk_case')">Open register</button></div>
                                <div class="card-body ims_heatmap_wrap">
                                    <div class="ims_heat_y">Probability</div>
                                    <div class="ims_heatmap">
                                        <t t-foreach="[5,4,3,2,1]" t-as="p" t-key="p"><div class="ims_heat_row"><span class="ims_axis" t-esc="p"/><t t-foreach="[1,2,3,4,5]" t-as="s" t-key="s"><div t-attf-class="ims_heat_cell #{getHeatClass(p,s)}"><strong t-esc="getHeatCount(p,s)"/></div></t></div></t>
                                        <div class="ims_heat_footer"><span/><span>1</span><span>2</span><span>3</span><span>4</span><span>5</span></div><div class="ims_heat_x">Severity</div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-12 col-xl-6">
                            <div class="card h-100">
                                <div class="card-header bg-white d-flex justify-content-between align-items-center"><div><strong>My Work</strong><div class="text-muted small"><span t-esc="state.data.kpis.my_open || 0"/> open · <span t-esc="state.data.kpis.my_overdue || 0"/> overdue</div></div><button type="button" class="btn btn-sm btn-secondary" t-on-click="openMyActions">View all</button></div>
                                <div class="list-group list-group-flush">
                                    <div t-if="!state.data.recent_actions.length" class="p-4 text-center text-muted">No IMS actions assigned.</div>
                                    <t t-foreach="state.data.recent_actions" t-as="a" t-key="a.id"><div t-attf-class="list-group-item #{a.is_overdue ? 'border-start border-danger border-3' : ''}"><div class="d-flex justify-content-between gap-3"><div><div><strong class="text-primary" t-esc="a.reference"/> <span class="badge text-bg-light" t-esc="a.source_type"/></div><div class="small" t-esc="a.name"/></div><div class="text-end small text-muted"><div t-esc="a.due_date || 'No due date'"/><span t-if="a.is_overdue" class="text-danger fw-semibold">OVERDUE</span></div></div></div></t>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="row g-3 mt-0">
                        <div class="col-12 col-lg-6"><div class="card"><div class="card-body"><div class="text-muted small">Next IMS Audit</div><t t-if="state.data.next_audit.title"><div class="fw-semibold" t-esc="state.data.next_audit.title"/><div class="small text-muted"><span t-esc="state.data.next_audit.name"/> · <span t-esc="state.data.next_audit.date || 'Date not set'"/></div></t><t t-else=""><div class="small text-muted">No open audit scheduled.</div></t></div></div></div>
                        <div class="col-12 col-lg-6"><div class="card"><div class="card-body"><div class="text-muted small">Next Management Review</div><t t-if="state.data.next_review.title"><div class="fw-semibold" t-esc="state.data.next_review.title"/><div class="small text-muted"><span t-esc="state.data.next_review.name"/> · <span t-esc="state.data.next_review.date || 'Date not set'"/></div></t><t t-else=""><div class="small text-muted">No open management review scheduled.</div></t></div></div></div>
                    </div>
                </div>
            </t>
        </div>
    </t>
</templates>
