<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="ir_cron_ims_daily_notifications" model="ir.cron">
        <field name="name">IMS Pro: Daily Notifications &amp; Escalations</field>
        <field name="model_id" ref="model_ims_notification_service"/>
        <field name="state">code</field>
        <field name="code">model.run_daily_notifications()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active">True</field>
    </record>

    <record id="notification_rule_action_7d" model="ims.notification.rule">
        <field name="name">IMS Action - 7 days before</field>
        <field name="event_type">action_due</field>
        <field name="days_before">7</field>
        <field name="escalation_days">7</field>
    </record>
    <record id="notification_rule_approval_3d" model="ims.notification.rule">
        <field name="name">Approval - 3 days before</field>
        <field name="event_type">approval_due</field>
        <field name="days_before">3</field>
    </record>
    <record id="notification_rule_document_30d" model="ims.notification.rule">
        <field name="name">Document Review - 30 days before</field>
        <field name="event_type">document_review</field>
        <field name="days_before">30</field>
    </record>
</odoo>
